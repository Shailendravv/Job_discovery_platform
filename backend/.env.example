# ──────────────────────────────────────────────────────────────────────
# Job Search Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════
# MongoDB
# ══════════════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/jobapp

# ══════════════════════════════════════════════════════════════════════
# LLM Provider — fixed Claude (Haiku) → Ollama chain. No other providers
# are supported on this branch; see AGENTS.md.
# ══════════════════════════════════════════════════════════════════════
LLM_PROVIDER=claude

# Claude (Anthropic API) — used for resume tailoring / cover letters.
# Credentials resolve from ANTHROPIC_API_KEY, or an `ant auth login`
# profile if you have the Anthropic CLI set up — not read from this file
# as a named setting, just from the environment.
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Ollama — local fallback if the Claude API call fails
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

MODEL_TEMPERATURE=0.1

# ══════════════════════════════════════════════════════════════════════
# Cloudinary — File Storage for Resumes
# ══════════════════════════════════════════════════════════════════════
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════════════════════════════
# Operations
# ══════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
