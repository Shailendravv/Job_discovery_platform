# ──────────────────────────────────────────────────────────────────────
# Job Search Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════
# MongoDB
# ══════════════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/jobapp

# ══════════════════════════════════════════════════════════════════════
# External Services — URLs
# ══════════════════════════════════════════════════════════════════════
SEARXNG_URL=http://localhost:8888
CAMOFOX_URL=http://localhost:9500
Ollama=http://localhost:11434

# ══════════════════════════════════════════════════════════════════════
# MCP Server URLs
# ══════════════════════════════════════════════════════════════════════
MCP_SEARCH_URL=http://localhost:8001
MCP_BROWSE_URL=http://localhost:8002

# ══════════════════════════════════════════════════════════════════════
# LLM Provider
# ══════════════════════════════════════════════════════════════════════
# Options:
#   "multi"     — provider-level fallback chain (Groq→Cerebras→SambaNova→NVIDIA→OpenRouter)
#   "ollama"    — local Ollama instance
#   "openrouter" — OpenRouter API with model-level fallback
#   "groq"      — Groq API directly
#   "cerebras"  — Cerebras API directly
#   "sambanova" — SambaNova API directly
#   "nvidia"    — NVIDIA NIM API directly
LLM_PROVIDER=ollama

# Provider chain for LLM_PROVIDER=multi (comma-separated, tried in order)
LLM_PROVIDER_CHAIN=groq,cerebras,sambanova,nvidia,openrouter

# Common settings
MODEL_NAME=qwen2.5-coder:1.5b
MODEL_TEMPERATURE=0.1

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# OpenRouter (used as the final step in multi-chain, or standalone)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=  # default: qwen/qwen3-coder:free

# Groq
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras
# Get your API key at: https://console.cerebras.ai/api-keys
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# SambaNova
# Get your API key at: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=gpt-oss-120b

# NVIDIA NIM
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ══════════════════════════════════════════════════════════════════════
# Cloudinary — File Storage for Resumes
# ══════════════════════════════════════════════════════════════════════
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════════════════════════════
# Search Configuration
# ══════════════════════════════════════════════════════════════════════
SEARCH_MAX_RESULTS=10
BROWSE_TOP_N=15
SEARCH_SITES=naukri.com,linkedin.com/jobs,apna.co,indeed.com,instahyre.com,shine.com,foundit.in
SEARCH_FRESH=true
SEARCH_CAREERS=false
SETTLE_SECONDS=1.5
MAX_SNAPSHOT_CHARS=12000

# ══════════════════════════════════════════════════════════════════════
# SearXNG
# ══════════════════════════════════════════════════════════════════════
SEARXNG_ENABLED=false

# ══════════════════════════════════════════════════════════════════════
# LinkedIn Guest API
# ══════════════════════════════════════════════════════════════════════
LINKEDIN_GUEST_API_ENABLED=false
LINKEDIN_GUEST_API_LOCATION=India
LINKEDIN_GUEST_API_TIME_RANGE=r86400
LINKEDIN_GUEST_API_MAX_RESULTS=15

# ══════════════════════════════════════════════════════════════════════
# Operations
# ══════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
