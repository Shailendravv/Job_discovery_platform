# ──────────────────────────────────────────────────────────────────────
# Job Search Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════
# MongoDB
# ══════════════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/jobapp

# ══════════════════════════════════════════════════════════════════════
# External Services — URLs
# ══════════════════════════════════════════════════════════════════════
SEARXNG_URL=http://localhost:8888
CAMOFOX_URL=http://localhost:9500
Ollama=http://localhost:11434

# ══════════════════════════════════════════════════════════════════════
# MCP Server URLs
# ══════════════════════════════════════════════════════════════════════
MCP_SEARCH_URL=http://localhost:8001
MCP_BROWSE_URL=http://localhost:8002

# ══════════════════════════════════════════════════════════════════════
# LLM Provider
# ══════════════════════════════════════════════════════════════════════
# Options: ollama (default), groq, gemini
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
MODEL_NAME=qwen2.5-coder:1.5b
MODEL_TEMPERATURE=0.1

# Groq API (used when LLM_PROVIDER=groq or for resume services)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Gemini API (not fully implemented yet)
GEMINI_API_KEY=

# ══════════════════════════════════════════════════════════════════════
# Cloudinary — File Storage for Resumes
# ══════════════════════════════════════════════════════════════════════
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════════════════════════════
# Search Configuration
# ══════════════════════════════════════════════════════════════════════
SEARCH_MAX_RESULTS=10
BROWSE_TOP_N=15
SEARCH_SITES=naukri.com,linkedin.com/jobs,apna.co,indeed.com,instahyre.com,shine.com,foundit.in
SEARCH_FRESH=true
SEARCH_CAREERS=false
SETTLE_SECONDS=1.5
MAX_SNAPSHOT_CHARS=12000

# ══════════════════════════════════════════════════════════════════════
# SearXNG
# ══════════════════════════════════════════════════════════════════════
SEARXNG_ENABLED=false

# ══════════════════════════════════════════════════════════════════════
# LinkedIn Guest API
# ══════════════════════════════════════════════════════════════════════
LINKEDIN_GUEST_API_ENABLED=false
LINKEDIN_GUEST_API_LOCATION=India
LINKEDIN_GUEST_API_TIME_RANGE=r86400
LINKEDIN_GUEST_API_MAX_RESULTS=15

# ══════════════════════════════════════════════════════════════════════
# Operations
# ══════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
