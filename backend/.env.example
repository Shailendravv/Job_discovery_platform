# ──────────────────────────────────────────────────────────────────────
# Job Search Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════
# MongoDB
# ══════════════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/jobapp

# ══════════════════════════════════════════════════════════════════════
# LLM Provider — default is Claude (Haiku) via the local Claude Code CLI,
# billed against your Claude Code subscription, → Ollama fallback. See
# backend/docs/llm.md and AGENTS.md for the full provider matrix.
# ══════════════════════════════════════════════════════════════════════
LLM_PROVIDER=claude-code

# Claude Code CLI — requires `claude` on PATH and an authenticated session
# (`claude auth login` / active subscription). No API key needed.
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=haiku

# Claude (Anthropic API, metered) — only used when LLM_PROVIDER=claude or
# claude-only. Credentials resolve from ANTHROPIC_API_KEY, or an
# `ant auth login` profile if you have the Anthropic CLI set up — not read
# from this file as a named setting, just from the environment.
# Get your API key at: https://console.anthropic.com/settings/keys
# Leave this blank while LLM_PROVIDER=claude-code.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Ollama — local fallback if the primary Claude call fails
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

MODEL_TEMPERATURE=0.1

# ══════════════════════════════════════════════════════════════════════
# Cloudinary — File Storage for Resumes
# ══════════════════════════════════════════════════════════════════════
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════════════════════════════
# Operations
# ══════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
